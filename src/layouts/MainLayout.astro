---
import '../styles/base.css';

interface NavItem {
  path: string;
  label: string;
  hide?: boolean;
}

const navItems: NavItem[] = [
  { path: '/', label: 'Home' },
  { path: '/blog', label: 'My life' },
  { path: '/link-friend', label: 'Friends' },
  { path: '/about', label: 'About', hide: true },
  { path: '/changelog', label: 'Changelog' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Astro.props.title ?? 'seeback の blog'} </title>
  </head>
  <body>
    <div class="basic-layout">
      <aside class="sidebar">
        <div class="sidebar-header">
          <a class="logo-link" href="/">
            <h1 class="site-title">seeback</h1>
          </a>
        </div>

        <nav class="nav-menu">
          {navItems
            .filter((item) => !item.hide)
            .map((item) => (
              <a
                href={item.path}
                class:list={['nav-item', { active: currentPath === item.path || currentPath.startsWith(item.path + '/') }]}
              >
                {item.label}
              </a>
            ))}
        </nav>

        <section class="social-section">
          <div class="social-title">Social</div>
          <a class="social-link" href="https://github.com/I-who-ant" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
          <a class="social-link" href="mailto:2391934808@qq.com">Email</a>
          <a
            class="social-link"
            href="https://music.163.com/#/user/home?id=467741872"
            target="_blank"
            rel="noopener noreferrer"
          >
            Music
          </a>
        </section>
      </aside>

      <main class="main-layout">
        <div class="content-body">
          <slot />
        </div>

        <footer class="global-footer">
          <div class="footer-divider"></div>

          <nav class="footer-links">
            <a class="footer-link" href="/about">about</a>
            <span class="separator">|</span>
            <a class="footer-link" href="/rss.xml" target="_blank" rel="noopener noreferrer">rss</a>
          </nav>

          <div class="footer-meta">
            <span>Copyright © 2021-2025 seeback</span>
            <span>Powered by seebackのblog</span>
          </div>

          <div class="footer-icons">
            <a class="icon-link" href="/rss.xml" target="_blank" rel="noopener noreferrer" aria-label="RSS">
              📡
            </a>
          </div>
        </footer>
      </main>
    </div>
  </body>
</html>
