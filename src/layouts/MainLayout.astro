---
import '../styles/base.css';
import NavMenu, { type NavItem } from '../components/NavMenu.astro';
import SocialLinks, { type SocialLink } from '../components/SocialLinks.astro';
import SiteFooter, { type FooterLink } from '../components/SiteFooter.astro';

const navItems: NavItem[] = [
  { path: '/', label: 'Home' },
  { path: '/projects', label: 'Projects' },
  { path: '/blog', label: 'Writings' },
  { path: '/link-friend', label: 'Friends' },
  { path: '/changelog', label: 'Changelog' },
];

const socialLinks: SocialLink[] = [
  { label: 'GitHub', href: 'https://github.com/I-who-ant', icon: 'github' },
  { label: 'Telegram', href: 'https://t.me/seebacker', icon: 'telegram' },
];

const footerLinks: FooterLink[] = [
  { label: 'about', href: '/about' },
  { label: 'rss', href: '/rss.xml', external: true },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Astro.props.title ?? 'seeback '} </title>
    <script is:inline>
      (() => {
        if (typeof window === 'undefined') return;
        const STORAGE_KEY = 'seeback-theme';
        const root = document.documentElement;
        const applyTheme = (theme) => {
          const nextTheme = theme === 'light' ? 'light' : 'dark';
          root.classList.toggle('theme-dark', nextTheme === 'dark');
          root.classList.toggle('theme-light', nextTheme === 'light');
          root.dataset.theme = nextTheme;
        };
        const resolveInitialTheme = () => {
          const cached = window.localStorage.getItem(STORAGE_KEY);
          if (cached === 'light' || cached === 'dark') {
            return cached;
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        const setTheme = (theme) => {
          applyTheme(theme);
          window.localStorage.setItem(STORAGE_KEY, theme);
        };
        applyTheme(resolveInitialTheme());
        const handleClick = (event) => {
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) {
            return;
          }
          event.preventDefault();
          const switchTheme = () => {
            const next = root.classList.contains('theme-dark') ? 'light' : 'dark';
            setTheme(next);
          };
          if (!document.startViewTransition) {
            switchTheme();
            return;
          }
          document.startViewTransition(switchTheme);
        };
        const bindToggle = () => {
          const logoLink = document.querySelector('.logo-link');
          if (!logoLink) return;
          logoLink.addEventListener('click', handleClick);
        };
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          bindToggle();
        } else {
          document.addEventListener('DOMContentLoaded', bindToggle, { once: true });
        }
      })();
    </script>
  </head>
  <body>
    <div class="basic-layout">
      <aside class="sidebar">
        <div class="sidebar-header">
          <a class="logo-link" href="/">
            <h1 class="site-title">seeback</h1>
          </a>
        </div>

        <NavMenu items={navItems} currentPath={currentPath} />

        <SocialLinks links={socialLinks} />
      </aside>

      <main class="main-layout">
        <div class="content-body">
          <slot />
        </div>

        <SiteFooter
          links={footerLinks}
          siteName="seeback"
          copyright="Copyright © 2021-2025 seeback"
        />
      </main>
    </div>
  </body>
</html>
