---
interface Props {
  title: string;
  description?: string;
  tooltip?: string;
}

const { title, description, tooltip } = Astro.props as Props;
---

<header class="page-header">
  <h1 class="page-title" title={tooltip}>{title}</h1>
  {description && <p class="page-description">{description}</p>}
  <slot />
</header>
