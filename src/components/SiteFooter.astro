---
export interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  links: FooterLink[];
  siteName: string;
  copyright: string;
  rssHref?: string;
}

const { links, siteName, copyright, rssHref = '/rss.xml' } = Astro.props as Props;
---

<footer class="global-footer">
  <div class="footer-divider"></div>

  <nav class="footer-links">
    {links.map((link, index) => (
      <span class="footer-link-group">
        <a
          class="footer-link"
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
        </a>
        {index < links.length - 1 && <span class="separator">|</span>}
      </span>
    ))}
  </nav>

</footer>
