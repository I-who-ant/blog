---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  basePath?: string;
  showExcerpt?: boolean;
  showDate?: boolean;
  emptyText?: string;
}

const {
  posts,
  basePath = '/blog',
  showExcerpt = true,
  showDate = true,
  emptyText = '暂无文章，欢迎稍后再来。',
} = Astro.props as Props;

const formatDate = (value: Date) =>
  value.toISOString().split('T')[0];
---

{posts.length === 0 ? (
  <p class="empty-tip">{emptyText}</p>
) : (
  <ul class="blog-list">
    {posts.map((post) => (
      <li class="blog-item">
        <div class="blog-left">
          {showDate && (
            <time class="blog-date" dateTime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          )}
          {post.data.tags && post.data.tags.length > 0 ? (
            <span class="blog-tags">
              {post.data.tags.map((tag) => (
                <span class="blog-tag">#{tag}</span>
              ))}
            </span>
          ) : (
            <span class="blog-category"># 未分类</span>
          )}
        </div>
        <div class="blog-right">
          <a class="blog-link" href={`${basePath}/${post.slug}/`}>
            <h3 class="blog-title">{post.data.title}</h3>
          </a>
          {showExcerpt && (post.data.description || post.data.excerpt) && (
            <p class="blog-excerpt">{post.data.description || post.data.excerpt}</p>
          )}
        </div>
      </li>
    ))}
  </ul>
)}
