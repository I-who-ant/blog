---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  basePath?: string;
  showExcerpt?: boolean;
  showDate?: boolean;
  emptyText?: string;
}

const {
  posts,
  basePath = '/blog',
  showExcerpt = true,
  showDate = true,
  emptyText = '暂无文章，欢迎稍后再来。',
} = Astro.props as Props;
---

{posts.length === 0 ? (
  <p class="empty-tip">{emptyText}</p>
) : (
  <ul class="blog-list">
    {posts.map((post) => (
      <li class="blog-item">
        <div class="blog-left">
          <time class="blog-date">{post.data.date}</time>
          <span class="blog-category">• 分享境</span>
        </div>
        <div class="blog-right">
          <a class="blog-link" href={`${basePath}/${post.slug}/`}>
            <h3 class="blog-title">{post.data.title}</h3>
          </a>
          {showExcerpt && post.data.excerpt && <p class="blog-excerpt">{post.data.excerpt}</p>}
        </div>
      </li>
    ))}
  </ul>
)}
